// One row per refresh token. Only the token's SHA-256 is stored, so a leaked row cannot be
// replayed as a login, and a row can be revoked to end a session before its token expires.
model Session {
  id String @id @default(uuid(7)) @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
