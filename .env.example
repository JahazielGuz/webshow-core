POSTGRES_USER=webshow
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=webshow
DATABASE_URL="postgresql://webshow:replace-me@localhost:5432/webshow"
TMDB_READ_ACCESS_TOKEN=replace-me

# Ed25519 signing key for access tokens, as a single-line private JWK with a kid. Generate one:
#   node --input-type=module -e "import {generateKeyPair,exportJWK} from 'jose'; const {privateKey} = await generateKeyPair('EdDSA', {crv:'Ed25519', extractable:true}); const jwk = await exportJWK(privateKey); jwk.kid = crypto.randomUUID(); console.log(JSON.stringify(jwk));"
AUTH_PRIVATE_JWK=replace-me
